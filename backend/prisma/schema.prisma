generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================
// USER & AUTH
// ========================
enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPERADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  firstName    String?
  lastName     String?
  phone        String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  refreshToken String?  @db.Text

  addresses Address[]
  /// @deprecated Legacy commerce relation retained for v1.0 rollback only.
  orders    Order[]
  /// @deprecated Legacy commerce relation retained for v1.0 rollback only.
  cart      Cart?
  /// @deprecated Legacy product reviews retained for v1.0 rollback only.
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

// ========================
// PRODUCT CATALOG
// ========================
/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?
  parentId    Int?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  logoUrl  String?
  products Product[]

  @@index([slug])
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  basePrice   Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    Int
  brand      Brand    @relation(fields: [brandId], references: [id])

  variants  Variant[]
  images    ProductImage[]
  reviews   Review[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt])
  @@fulltext([name, description])
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  publicId  String // Cloudinary public_id for deletion
  isPrimary Boolean @default(false)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// @deprecated Legacy product inventory. Service quotation MATERIAL lines remain active.
model Variant {
  id        Int     @id @default(autoincrement())
  sku       String  @unique
  name      String // e.g., "Red / Large"
  price     Decimal @db.Decimal(12, 2)
  stock     Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([productId])
  @@index([sku(length: 20)])
}

// ========================
// SHOPPING CART
// ========================
/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  updatedAt DateTime @updatedAt
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ========================
// ADDRESSES
// ========================
model Address {
  id            Int     @id @default(autoincrement())
  userId        Int
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  province      String
  district      String
  ward          String
  streetAddress String
  isDefault     Boolean @default(false)

  /// @deprecated Legacy commerce relation retained for v1.0 rollback only.
  orders Order[]

  @@index([userId])
}

// ========================
// ORDERS
// ========================
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model Order {
  id          Int     @id @default(autoincrement())
  orderNumber String  @unique
  userId      Int
  user        User    @relation(fields: [userId], references: [id])
  addressId   Int
  address     Address @relation(fields: [addressId], references: [id])

  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  note        String?     @db.Text

  items    OrderItem[]
  payment  Payment?
  shipping Shipping?
  couponId Int?
  coupon   Coupon?     @relation(fields: [couponId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

/// @deprecated Legacy commerce model retained for v1.0 rollback. Not exposed by service-only runtime.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])

  productName String // Snapshot at time of purchase
  variantName String // Snapshot
  price       Decimal @db.Decimal(12, 2) // Snapshot price
  quantity    Int

  @@index([orderId])
  @@index([variantId])
}

// ========================
// PAYMENTS
// ========================
enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// @deprecated Legacy order payment only. ServicePaymentRecord remains active.
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique // VNPay/MoMo transaction ID
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?
  rawResponse   Json? // Store raw payment gateway response

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([status])
}

// ========================
// SHIPPING
// ========================
enum ShippingStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

/// @deprecated Legacy shipping model retained for v1.0 rollback. Not exposed by service-only runtime.
model Shipping {
  id             Int            @id @default(autoincrement())
  orderId        Int            @unique
  order          Order          @relation(fields: [orderId], references: [id])
  carrier        String?
  trackingNumber String?
  status         ShippingStatus @default(PENDING)
  estimatedDate  DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingNumber])
}

// ========================
// REVIEWS
// ========================
/// @deprecated Legacy product review. ServiceRequestReview remains active.
model Review {
  id        Int     @id @default(autoincrement())
  rating    Int // 1-5
  comment   String? @db.Text
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // One review per product per user
  @@index([productId])
  @@index([rating])
}

// ========================
// COUPONS
// ========================
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// @deprecated Legacy commerce promotion retained for v1.0 rollback. Not exposed by service-only runtime.
model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  description    String?
  type           DiscountType
  value          Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(true)

  orders Order[]

  @@index([code])
  @@index([isActive, startDate, endDate])
}

// ========================
// SERVICE REQUESTS & TECHNICIANS (Added in 10A)
// ========================
enum ServiceRequestStatus {
  pending
  confirmed
  assigned
  completed
  cancelled
}

enum ServiceRequestPriority {
  low
  medium
  high
  urgent
}

enum TechnicianStatus {
  available
  busy
  offline
  inactive
}

model ServiceCategory {
  id                String           @id // e.g. "sua-dieu-hoa", "ve-sinh-dieu-hoa"
  name              String
  slug              String           @unique
  icon              String?
  description       String?          @db.Text
  referencePriceMin Decimal?         @db.Decimal(12, 2)
  referencePriceMax Decimal?         @db.Decimal(12, 2)
  surveyFee         Decimal          @default(0) @db.Decimal(12, 2)
  pricingNote       String?          @db.VarChar(500)
  requests          ServiceRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([slug])
}

model Technician {
  id             String           @id // e.g. "TECH-001"
  name           String
  phone          String           @unique
  email          String           @unique
  avatar         String?
  rating         Decimal          @default(5.0) @db.Decimal(3, 2)
  skills         Json // Array of service category IDs, e.g. ["sua-dieu-hoa"]
  workingAreas   Json // Array of districts, e.g. ["Quận Cầu Giấy"]
  status         TechnicianStatus @default(available)
  completedCount Int              @default(0)
  requests       ServiceRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model ServiceRequest {
  id                          String                 @id // e.g. "SR-240601"
  customerName                String
  customerPhone               String
  customerAddress             String
  district                    String
  priority                    ServiceRequestPriority @default(medium)
  applianceType               String
  issueDescription            String                 @db.Text
  images                      Json? // Array of image URLs
  preferredDate               String // e.g. "2026-07-05"
  preferredTimeSlot           String // e.g. "08:00 - 10:00"
  note                        String?                @db.Text
  status                      ServiceRequestStatus   @default(pending)
  estimatedPrice              Decimal                @default(0) @db.Decimal(12, 2)
  finalPrice                  Decimal                @default(0) @db.Decimal(12, 2)
  paymentStatus               String                 @default("unpaid") // "unpaid" | "paid"
  customerEmail               String?                @db.VarChar(191)
  workflowStatus              String                 @default("NEW") @db.VarChar(32)
  requestVersion              Int                    @default(1)
  source                      String                 @default("WEB") @db.VarChar(32)
  scheduledAt                 DateTime?
  confirmedAt                 DateTime?
  assignedAt                  DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  warrantyStartedAt           DateTime?
  closedAt                    DateTime?
  lastStatusChangedAt         DateTime               @default(now())
  lookupLastFour              String?                @db.VarChar(4)
  customerUserId              Int?
  pricingDisclosureVersion    String                 @default("2026-07-v1") @db.VarChar(32)
  pricingDisclosureAcceptedAt DateTime?
  referencePriceMinSnapshot   Decimal?               @db.Decimal(12, 2)
  referencePriceMaxSnapshot   Decimal?               @db.Decimal(12, 2)
  surveyFeeSnapshot           Decimal                @default(0) @db.Decimal(12, 2)
  statusHistory               Json? // Array of history objects
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  serviceCategoryId    String
  serviceCategory      ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  assignedTechnicianId String?
  assignedTechnician   Technician?     @relation(fields: [assignedTechnicianId], references: [id])

  @@index([status])
  @@index([serviceCategoryId])
  @@index([assignedTechnicianId])
  @@index([customerUserId, createdAt])
}

model LegacyDomainMetadata {
  id             BigInt   @id @default(autoincrement())
  domain         String   @db.VarChar(64)
  tableName      String   @unique @db.VarChar(191)
  lifecycle      String   @default("LEGACY_READ_ONLY") @db.VarChar(32)
  runtimeExposed Boolean  @default(false)
  archivedAt     DateTime @default(now())
  backupChecksum String?  @db.VarChar(128)
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([domain, lifecycle])
}

model ServiceRequestSubmission {
  id                     BigInt   @id @default(autoincrement())
  idempotencyKeyHash     String   @unique @db.Char(64)
  requestFingerprintHash String   @db.Char(64)
  requestId              String
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  @@index([requestId])
  @@index([expiresAt])
}

model ServiceRequestScheduleChange {
  id                    BigInt   @id @default(autoincrement())
  requestId             String
  fromPreferredDate     String   @db.VarChar(32)
  fromPreferredTimeSlot String   @db.VarChar(80)
  toPreferredDate       String   @db.VarChar(32)
  toPreferredTimeSlot   String   @db.VarChar(80)
  reason                String   @db.VarChar(500)
  actorType             String   @db.VarChar(32)
  actorId               String?  @db.VarChar(64)
  fromRequestVersion    Int
  toRequestVersion      Int
  createdAt             DateTime @default(now())

  @@index([requestId, createdAt])
}

model SystemSetting {
  id                    String   @id @default("default")
  storeName             String
  hotline               String
  zalo                  String
  email                 String
  address               String
  shippingFee           Decimal  @default(30000) @db.Decimal(12, 2)
  freeShippingThreshold Decimal  @default(10000000) @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model PersonalDataRequest {
  id            String   @id @db.Char(36)
  userId        Int
  requestType   String   @db.VarChar(32)
  status        String   @default("RECEIVED") @db.VarChar(32)
  reason        String?  @db.VarChar(500)
  legalHoldNote String?  @db.VarChar(500)
  requestedAt   DateTime @default(now())
  dueAt         DateTime
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, requestedAt])
  @@index([status, dueAt])
}
